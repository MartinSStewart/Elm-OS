+            Context.freshVar ctx2
+
+        ( listResult, ctx4 ) =
+            Context.freshVar ctx3
+
+        ( beforeCount, ctx5 ) =
+            Context.freshVar ctx4
+
+        ( beforeList, ctx6 ) =
+            Context.freshVar ctx5
+
+        ( tagVar, ctx7 ) =
+            Context.freshVar ctx6
+
+        ( ctx8, tagOp ) =
