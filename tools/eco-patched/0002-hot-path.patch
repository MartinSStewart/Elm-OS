+
+                FU32 endian expr ->
+                    FU32 endian (wrap expr)
+
+                FF32 endian expr ->
+                    FF32 endian (wrap expr)
+
+                FF64 endian expr ->
+                    FF64 endian (wrap expr)
+    in
+    case node of
+        EU8 expr ->
+            EU8 (wrap expr)
+
+        EU16 endian expr ->
+            EU16 endian (wrap expr)
+
+        EU32 endian expr ->
+            EU32 endian (wrap expr)
+
+        EF32 endian expr ->
+            EF32 endian (wrap expr)
+
+        EF64 endian expr ->
+            EF64 endian (wrap expr)
+
+        EBytes expr ->
+            EBytes (wrap expr)
+
+        EUtf8 expr ->
+            EUtf8 (wrap expr)
+
