+                |> Ops.opBuilder.withOperands [ beforeList ]
+                |> Ops.opBuilder.withResults [ ( tagVar, I32 ) ]
+                |> Ops.opBuilder.withAttrs
+                    (Dict.singleton "_operand_types"
