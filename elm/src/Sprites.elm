module Sprites exposing (Name(..), Sprite, get)

{-| Where each sprite of sprites/ (at the top of the repository) is in the texture
atlas. GENERATED by `make` from those files, the way the host packs them
(host/common/src/sprites.rs, examples/sprites-elm.rs): don't edit this, edit the files.
-}


{-| One sprite: the files NAME.1x.webp and NAME.2x.webp in sprites/.
-}
type Name
    = CursorArrow
    | CursorCrosshair
    | CursorMove
    | CursorNotAllowed
    | CursorPointer
    | CursorResizeEastWest
    | CursorResizeNorthSouth
    | CursorResizeNortheastSouthwest
    | CursorResizeNorthwestSoutheast
    | CursorText
    | CursorWait
    | DotGrid
    | Solid


{-| A sprite at one UI scale, in device pixels: its size, its hot spot (the pixel that
is its position, from sprites/hot-spots.txt), and where in the atlas its fill (its
white parts, drawn in any colour) and its outline (its black parts, if it has any) are:
the top left corner of a rectangle its size.
-}
type alias Sprite =
    { width : Int, height : Int, hotSpot : ( Int, Int ), fill : ( Int, Int ), outline : Maybe ( Int, Int ) }


{-| A sprite for a UI scale: the 2x picture from scale 2 up.
-}
get : Int -> Name -> Sprite
get scale name =
    case name of
        CursorArrow ->
            if scale >= 2 then
                { width = 24, height = 38, hotSpot = ( 0, 0 ), fill = ( 81, 3585 ), outline = Just ( 107, 3585 ) }

            else
                { width = 12, height = 19, hotSpot = ( 0, 0 ), fill = ( 809, 3585 ), outline = Just ( 823, 3585 ) }

        CursorCrosshair ->
            if scale >= 2 then
                { width = 32, height = 30, hotSpot = ( 14, 14 ), fill = ( 619, 3585 ), outline = Just ( 653, 3585 ) }

            else
                { width = 16, height = 15, hotSpot = ( 7, 7 ), fill = ( 1113, 3585 ), outline = Just ( 1131, 3585 ) }

        CursorMove ->
            if scale >= 2 then
                { width = 38, height = 38, hotSpot = ( 18, 18 ), fill = ( 133, 3585 ), outline = Just ( 173, 3585 ) }

            else
                { width = 19, height = 19, hotSpot = ( 9, 9 ), fill = ( 837, 3585 ), outline = Just ( 858, 3585 ) }

        CursorNotAllowed ->
            if scale >= 2 then
                { width = 40, height = 36, hotSpot = ( 20, 18 ), fill = ( 261, 3585 ), outline = Just ( 303, 3585 ) }

            else
                { width = 20, height = 18, hotSpot = ( 10, 9 ), fill = ( 905, 3585 ), outline = Just ( 927, 3585 ) }

        CursorPointer ->
            if scale >= 2 then
                { width = 38, height = 40, hotSpot = ( 12, 0 ), fill = ( 1, 3585 ), outline = Just ( 41, 3585 ) }

            else
                { width = 19, height = 20, hotSpot = ( 6, 0 ), fill = ( 767, 3585 ), outline = Just ( 788, 3585 ) }

        CursorResizeEastWest ->
            if scale >= 2 then
                { width = 38, height = 22, hotSpot = ( 18, 10 ), fill = ( 687, 3585 ), outline = Just ( 727, 3585 ) }

            else
                { width = 19, height = 11, hotSpot = ( 9, 5 ), fill = ( 1149, 3585 ), outline = Just ( 1170, 3585 ) }

        CursorResizeNorthSouth ->
            if scale >= 2 then
                { width = 22, height = 38, hotSpot = ( 10, 18 ), fill = ( 213, 3585 ), outline = Just ( 237, 3585 ) }

            else
                { width = 11, height = 19, hotSpot = ( 5, 9 ), fill = ( 879, 3585 ), outline = Just ( 892, 3585 ) }

        CursorResizeNortheastSouthwest ->
            if scale >= 2 then
                { width = 32, height = 32, hotSpot = ( 16, 14 ), fill = ( 449, 3585 ), outline = Just ( 483, 3585 ) }

            else
                { width = 16, height = 16, hotSpot = ( 8, 7 ), fill = ( 1005, 3585 ), outline = Just ( 1023, 3585 ) }

        CursorResizeNorthwestSoutheast ->
            if scale >= 2 then
                { width = 32, height = 32, hotSpot = ( 14, 14 ), fill = ( 517, 3585 ), outline = Just ( 551, 3585 ) }

            else
                { width = 16, height = 16, hotSpot = ( 7, 7 ), fill = ( 1041, 3585 ), outline = Just ( 1059, 3585 ) }

        CursorText ->
            if scale >= 2 then
                { width = 18, height = 36, hotSpot = ( 8, 18 ), fill = ( 345, 3585 ), outline = Just ( 365, 3585 ) }

            else
                { width = 9, height = 18, hotSpot = ( 4, 9 ), fill = ( 949, 3585 ), outline = Just ( 960, 3585 ) }

        CursorWait ->
            if scale >= 2 then
                { width = 30, height = 36, hotSpot = ( 14, 18 ), fill = ( 385, 3585 ), outline = Just ( 417, 3585 ) }

            else
                { width = 15, height = 18, hotSpot = ( 7, 9 ), fill = ( 971, 3585 ), outline = Just ( 988, 3585 ) }

        DotGrid ->
            if scale >= 2 then
                { width = 32, height = 32, hotSpot = ( 0, 0 ), fill = ( 585, 3585 ), outline = Nothing }

            else
                { width = 16, height = 16, hotSpot = ( 0, 0 ), fill = ( 1077, 3585 ), outline = Nothing }

        Solid ->
            if scale >= 2 then
                { width = 16, height = 16, hotSpot = ( 0, 0 ), fill = ( 1095, 3585 ), outline = Nothing }

            else
                { width = 8, height = 8, hotSpot = ( 0, 0 ), fill = ( 1191, 3585 ), outline = Nothing }
