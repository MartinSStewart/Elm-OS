# hostapd's build options (its .config): only for the simulated access point in QEMU
# (scripts/wifi-sim-hostapd.conf), a WPA2-Personal network on mac80211_hwsim.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211W=y
# Its own crypto instead of OpenSSL, like wpa_supplicant.
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
