# wpa_supplicant's build options (its .config); the Makefile adds the compiler flags.
# The nl80211 driver (every current wifi card), the control socket host/init talks to,
# and WPA2-Personal with protected management frames.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_IEEE80211W=y
# Its own crypto instead of OpenSSL. That has no elliptic curves, so no SAE: WPA3-only
# networks can't be joined (WPA2/WPA3 mixed ones can, over WPA2).
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
