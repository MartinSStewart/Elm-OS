# Elm OS kernel options, merged on top of `make tinyconfig`.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
# gzip rather than tinyconfig's xz: the USB kernel carries the 60 MB initramfs,
# and xz takes about 40 s to squeeze it (for 17 MB rather than gzip's 23 MB).
CONFIG_KERNEL_XZ=n
CONFIG_KERNEL_GZIP=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Boot straight into /init from an initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y

# What the eco runtime (threads, GC, event loop, mimalloc) needs
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_SIGNALFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_MULTIUSER=y

# Devices: virtio over PCI in QEMU
CONFIG_PCI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y

# Input: evdev
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y

# Display: DRM/KMS
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y

# ---- Real PCs (tested target: Intel Tiger Lake laptop). The QEMU build uses
# the same kernel, so all of this is in every build.

# x86 platform basics that tinyconfig leaves out
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y
CONFIG_X86_X2APIC=y
CONFIG_X86_MPPARSE=y
CONFIG_PCI_MSI=y
CONFIG_HPET_TIMER=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_IRQ_REMAP=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y

# UEFI: the kernel is its own EFI program (BOOTX64.EFI on the USB stick)
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_HANDOVER_PROTOCOL=y
CONFIG_FB_EFI=n
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y

# ACPI: power button, PNP (finds the i8042 keyboard), I2C touchpads, GPIOs, the
# battery (/sys/class/power_supply) and the firmware's boot times (FPDT), both for the
# debug overlay
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_VIDEO=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_FPDT=y
CONFIG_PNP=y
CONFIG_PNPACPI=y

# Display: Intel graphics, and the firmware's framebuffer until (or if not) i915 takes over
CONFIG_DRM_I915=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# NVIDIA graphics (desktops): nouveau, the open driver. It drives the screen on any
# NVIDIA card. With NVIDIA's signed firmware (in the USB image for Maxwell 2 and
# Pascal cards, such as the GTX 1080) it also runs Mesa's OpenGL; it can't raise the
# card's clocks, so it runs slowly for games, but fast enough for Elm OS.
CONFIG_DRM_NOUVEAU=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Kernel messages on the screen, so a failed boot on a laptop shows why
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

# Keyboards and mice: USB (xHCI), the laptop's built-in PS/2 keyboard, and
# touchpads on I2C (Intel LPSS + i2c-hid, the usual Tiger Lake setup) or PS/2
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_GPIOLIB=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y

# USB sticks: the debug overlay shows the SHA-256 of the Elm OS image it booted from
# (elm/src/BootInfo.elm reads it through the host), and the stick's "Elm OS data"
# partition (ext4, found by its GPT name) keeps the Elm program's saved state
# (host/init/src/persist.rs). In QEMU that partition is on a virtio disk.
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_VIRTIO_BLK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y

# Deliberately absent: NVMe and SATA drivers. Elm OS runs from RAM, so it can't
# read or write the computer's own disk; only the partition named "Elm OS data".

# ---- Networking: wifi on Intel cards (the Tiger Lake laptop's AX201), wired
# Ethernet, and a simulated wifi card in QEMU (mac80211_hwsim; host/init/src/net
# finds its radios and, with the files from build/wifi-sim.cpio, runs a test access
# point on one of them). wpa_supplicant joins wifi networks; the host does DHCP
# itself and HTTPS in Rust (host/init/src/http.rs).
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
# Wired Ethernet on desktops: Intel's gigabit chips on most Intel boards (e1000e,
# I217/I218/I219, also QEMU's e1000e card), Intel 2.5G (igc, I225/I226), and Realtek
# (r8169, the usual one on AMD and cheaper boards; a few need firmware we don't ship).
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=y
CONFIG_IGC=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_BRIDGE=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_MAC80211_HWSIM=y
# TLS checks certificate dates, so the clock must be right from boot
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
